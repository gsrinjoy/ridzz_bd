    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@jitsi/rnnoise-wasm": "0.2.1",
    "@preact/signals": "^2.11.4",
    "maplibre-gl": "^5.24.0",
    "preact": "^11.2.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
